<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse Proxy /api and /uploads to Node.js Backend (port 3000) if Apache mod_proxy is available
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
    RewriteRule ^uploads/(.*)$ http://127.0.0.1:3000/uploads/$1 [P,L]
  </IfModule>

  # 2. SPA Fallback: Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteRule ^ index.html [L]
</IfModule>

# Security & Cache Control Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
