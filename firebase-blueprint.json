{
  "collections": [
    {
      "name": "settings",
      "description": "System wide settings",
      "documents": [
        {
          "id": "system",
          "fields": [
            {
              "name": "currentYear",
              "type": "number",
              "description": "Current active year for the system"
            },
            {
              "name": "startSequence",
              "type": "number",
              "description": "Starting sequence number"
            },
            {
              "name": "orgName",
              "type": "string",
              "description": "Organization name"
            },
            {
              "name": "logoUrl",
              "type": "string",
              "description": "URL to the system logo image"
            },
            {
              "name": "footerText",
              "type": "string",
              "description": "Footer text for the system"
            }
          ]
        }
      ]
    },
    {
      "name": "departments",
      "description": "Departments or groups",
      "documents": [
        {
          "id": "departmentId",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "description": "Name of the department"
            },
            {
              "name": "description",
              "type": "string",
              "description": "Description of the department"
            }
          ]
        }
      ]
    },
    {
      "name": "users",
      "description": "User profiles",
      "documents": [
        {
          "id": "userId",
          "fields": [
            {
              "name": "username",
              "type": "string",
              "description": "Username"
            },
            {
              "name": "firstName",
              "type": "string",
              "description": "First name"
            },
            {
              "name": "lastName",
              "type": "string",
              "description": "Last name"
            },
            {
              "name": "position",
              "type": "string",
              "description": "Job position"
            },
            {
              "name": "role",
              "type": "string",
              "description": "User role: admin or user"
            }
          ]
        }
      ]
    },
    {
      "name": "documents",
      "description": "Documents tracking (inbox/outbox)",
      "documents": [
        {
          "id": "docId",
          "fields": [
            {
              "name": "type",
              "type": "string",
              "description": "inbox or outbox"
            },
            {
              "name": "docNumber",
              "type": "string"
            },
            {
              "name": "receiveNumber",
              "type": "string"
            },
            {
              "name": "date",
              "type": "timestamp"
            },
            {
              "name": "registerDate",
              "type": "timestamp"
            },
            {
              "name": "from",
              "type": "string"
            },
            {
              "name": "to",
              "type": "string"
            },
            {
              "name": "title",
              "type": "string"
            },
            {
              "name": "department",
              "type": "string"
            },
            {
              "name": "assignee",
              "type": "string"
            },
            {
              "name": "note",
              "type": "string"
            },
            {
              "name": "priority",
              "type": "string"
            },
            {
              "name": "status",
              "type": "string"
            },
            {
              "name": "year",
              "type": "number"
            }
          ]
        }
      ]
    }
  ]
}
