# Plesk / Apache .htaccess Configuration for Dynamic Routing & SPA Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to real static files and folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct API and Uploads pass-through
  RewriteRule ^api/(.*)$ - [L]
  RewriteRule ^uploads/(.*)$ - [L]

  # Route all dynamic URLs, full long links, and SPA routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
